<!-- Copies style-related files to the output directory of a consuming project -->
<Project>
	<PropertyGroup>
		<GraphiteUiThemeDir Condition="'$(GraphiteUiThemeDir)' == '' and '$(GraphiteUI)' != ''">$(GraphiteUI)</GraphiteUiThemeDir>
		<GraphiteUiThemeDir Condition="'$(GraphiteUiThemeDir)' == ''">$(MSBuildProjectDirectory)\bin\GraphiteUi</GraphiteUiThemeDir>
	</PropertyGroup>

	<Target Name="GraphiteUi_CopyThemeContents" BeforeTargets="PrepareForBuild">
		<ItemGroup>
			<GraphiteUiThemeFiles Include="$(MSBuildThisFileDirectory)..\theme\**\*" />
		</ItemGroup>
		<MakeDir Directories="$(GraphiteUiThemeDir)" />

		<Copy SourceFiles="@(GraphiteUiThemeFiles)"
		      DestinationFiles="@(GraphiteUiThemeFiles->'$(GraphiteUiThemeDir)/%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
