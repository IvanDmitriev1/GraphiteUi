@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiComponent As="@As"
             Class="@Class"
             DataUi="avatar"
             data-size="@Size.ToAttributeValue()"
             @attributes="@AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Src))
    {
        <img src="@Src"
             alt="@Alt"
             data-part="image" />
    }
    else
    {
        @Initials
    }
</UiComponent>
