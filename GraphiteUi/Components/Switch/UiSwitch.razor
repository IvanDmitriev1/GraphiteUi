@namespace GraphiteUi.Components
@inherits UiInputBase<bool>

<label class="@Class"
       @attributes="@AdditionalAttributes"
       data-ui="switch"
       data-checked="@CurrentValue.ToAttributeValue()"
       data-disabled="@Disabled.ToAttributeValue()"
       data-invalid="@IsInvalid.ToAttributeValue()"
       data-readonly="@ReadOnly.ToAttributeValue()">

	<input type="checkbox"
	       data-part="input"
	       value="true"
	       checked="@CurrentValue"
	       disabled="@Disabled"
	       aria-disabled="@Disabled.ToAttributeValue()"
	       aria-invalid="@IsInvalid.ToAttributeValue()"
	       aria-readonly="@ReadOnly.ToAttributeValue()"
	       name="@NameAttributeValue"
	       @onchange="@OnChangeAsync"/>

	<span data-part="track"
	      data-invalid="@IsInvalid.ToAttributeValue()">
		<span data-part="thumb"></span>
	</span>

	@if (ChildContent is not null)
	{
		<span data-part="label">@ChildContent</span>
	}
</label>
