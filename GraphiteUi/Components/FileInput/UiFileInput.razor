@namespace GraphiteUi.Components
@inherits UiInputBase<IReadOnlyList<IBrowserFile>>

<div class="@Class" data-ui="file-input">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label data-part="label">@Label</label>
    }

    <InputFile data-part="input"
               multiple="@Multiple"
               disabled="@Disabled"
               aria-invalid="@IsInvalid.ToAttributeValue()"
               @attributes="@AdditionalAttributes"
               OnChange="OnFilesChangedAsync" />

    @if ((CurrentValue?.Count ?? 0) > 0)
    {
        <div data-part="info">
            @($"{CurrentValue!.Count} file(s) selected")
        </div>
    }
</div>
