@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiComponent As="@ResolvedAs"
             Class="@Class"
             DataUi="menu-item"
             data-part="root"
             data-disabled="@Disabled.ToAttributeValue()"
             data-slot="menu-item"
             disabled="@(ResolvedAs == "button" ? Disabled : null)"
             href="@ResolvedHref"
             target="@Target"
             rel="@Rel"
             aria-disabled="@Disabled.ToAttributeValue()"
             @onclick="OnClickAsync"
             @attributes="@AdditionalAttributes">
    @StartContent
    @ChildContent
    @EndContent
</UiComponent>
