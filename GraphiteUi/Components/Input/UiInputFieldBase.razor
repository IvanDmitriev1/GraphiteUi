@namespace GraphiteUi.Components
@inherits UiDebouncedInputBase<TValue>
@typeparam TValue

<div class="@Class">
    <div data-slot="input-wrapper"
         data-invalid="@IsInvalid"
         data-readonly="@ReadOnly"
         data-disabled="@Disabled"
         data-active="@(!string.IsNullOrWhiteSpace(CurrentValueAsString))"
         class="@DefaultUiInputFieldStyles.InputWrapperClass"
         @ref="_wrapperReference">

        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="@DefaultUiInputFieldStyles.LabelClass"
                   data-slot="label">
                @Label
            </label>
        }

        <input type="@TypeString"
               class="@DefaultUiInputFieldStyles.InputClass"
               value="@CurrentValueAsString"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-disabled="@Disabled"
               aria-readonly="@ReadOnly"
               aria-label="@Label"
               name="@NameAttributeValue"
               data-slot="input"
               @attributes="@AdditionalAttributes"
               @oninput="@OnInputAsync"/>
    </div>
</div>
