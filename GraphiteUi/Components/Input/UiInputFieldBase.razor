@namespace GraphiteUi.Components
@inherits UiDebouncedInputBase<TValue>
@typeparam TValue

<div class="@Class">
    <div data-slot="input-wrapper"
         data-invalid="@IsInvalid"
         data-readonly="@ReadOnly"
         data-disabled="@Disabled"
         data-trailing="@((TrailingContent is not null).ToAttributeValue())"
         data-active="@(!string.IsNullOrWhiteSpace(CurrentValueAsString) || !string.IsNullOrWhiteSpace(Placeholder))"
         class="@InputWrapperClass">

        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="@DefaultUiInputFieldStyles.LabelClass"
                   data-slot="label">
                @Label
            </label>
        }

        @if (IsMultiline)
        {
            <textarea class="@InputElementClass"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      readonly="@ReadOnly"
                      required="@Required"
                      aria-disabled="@Disabled"
                      aria-readonly="@ReadOnly"
                      aria-label="@Label"
                      name="@NameAttributeValue"
                      rows="@TextareaRows"
                      data-slot="input"
                      @attributes="@AdditionalAttributes"
                      @oninput="@OnInputAsync">@CurrentValueAsString</textarea>
        }
        else
        {
            <input type="@TypeString"
                   class="@InputElementClass"
                   value="@CurrentValueAsString"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-disabled="@Disabled"
                   aria-readonly="@ReadOnly"
                   aria-label="@Label"
                   name="@NameAttributeValue"
                   data-slot="input"
                   @attributes="@AdditionalAttributes"
                   @oninput="@OnInputAsync"/>
        }

        @if (TrailingContent is not null)
        {
            <span data-slot="input-trailing"
                  class="@DefaultUiInputFieldStyles.InputTrailingClass">
                @TrailingContent
            </span>
        }
    </div>
</div>
