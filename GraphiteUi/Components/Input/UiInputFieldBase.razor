@namespace GraphiteUi.Components
@inherits UiDebouncedInputBase<TValue>
@typeparam TValue

<div class="@Class">
    <div data-slot="input-wrapper"
         data-invalid="@IsInvalid"
         data-readonly="@ReadOnly"
         data-disabled="@Disabled"
         data-trailing="@((TrailingContent is not null).ToAttributeValue())"
         data-active="@(!string.IsNullOrWhiteSpace(CurrentValueAsString) || !string.IsNullOrWhiteSpace(Placeholder))"
         class="@InputWrapperClass">

        @if (!string.IsNullOrEmpty(Label))
        {
            <label for="@InputId" class="@DefaultUiInputFieldStyles.LabelClass"
                   data-slot="label">
                @Label
            </label>
        }

        @if (IsMultiline)
        {
            <textarea @attributes="@AdditionalAttributes"
                      id="@InputId"
                      aria-describedby="@DescribedBy"
                      aria-invalid="@IsInvalid.ToAttributeValue()"
                      class="@InputElementClass"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      readonly="@ReadOnly"
                      required="@Required"
                      aria-disabled="@Disabled.ToAttributeValue()"
                      aria-readonly="@ReadOnly.ToAttributeValue()"
                      aria-label="@AccessibleLabel"
                      name="@NameAttributeValue"
                      rows="@TextareaRows"
                      data-slot="input"
                      @oninput="@OnInputAsync">@CurrentValueAsString</textarea>
        }
        else
        {
            <input @attributes="@AdditionalAttributes"
                   id="@InputId"
                   aria-describedby="@DescribedBy"
                   aria-invalid="@IsInvalid.ToAttributeValue()"
                   inputmode="@InputMode"
                   step="@InputStep"
                   type="@TypeString"
                   class="@InputElementClass"
                   value="@CurrentValueAsString"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-disabled="@Disabled.ToAttributeValue()"
                   aria-readonly="@ReadOnly.ToAttributeValue()"
                   aria-label="@AccessibleLabel"
                   name="@NameAttributeValue"
                   data-slot="input"
                   @oninput="@OnInputAsync"/>
        }

        @if (TrailingContent is not null)
        {
            <span data-slot="input-trailing"
                  class="@DefaultUiInputFieldStyles.InputTrailingClass">
                @TrailingContent
            </span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p id="@DescriptionId" class="@DefaultUiInputFieldStyles.DescriptionClass">@Description</p>
    }
</div>
