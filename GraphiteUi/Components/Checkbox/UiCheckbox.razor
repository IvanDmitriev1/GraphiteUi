@namespace GraphiteUi.Components
@inherits UiInputBase<bool>

<label class="@RootClass"
       data-checked="@CurrentValue.ToAttributeValue()"
       data-disabled="@Disabled.ToAttributeValue()"
       data-invalid="@IsInvalid.ToAttributeValue()"
       data-readonly="@ReadOnly.ToAttributeValue()"
       @attributes="@AdditionalAttributes">
    <input type="checkbox"
           class="@InputClass"
           value="true"
           checked="@CurrentValue"
           disabled="@Disabled"
           aria-disabled="@Disabled"
           aria-invalid="@IsInvalid"
           aria-readonly="@ReadOnly"
           name="@NameAttributeValue"
           @onchange="@OnChangeAsync" />

    <span class="@ControlClass"
          data-invalid="@IsInvalid.ToAttributeValue()"
          aria-hidden="true">
        <svg class="@IconClass"
             viewBox="0 0 16 16"
             fill="none"
             xmlns="http://www.w3.org/2000/svg">
            <path d="M3.5 8.5L6.5 11.5L12.5 5.5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
        </svg>
    </span>

    @if (ChildContent is not null)
    {
        <span class="@LabelClass">
            @ChildContent
        </span>
    }

</label>
