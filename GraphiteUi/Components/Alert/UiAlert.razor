@namespace GraphiteUi.Components
@inherits UiComponentBase

@if (Visible)
{
    <UiComponent As="@As"
                 Class="@Class"
                 DataUi="alert"
                 role="@ResolvedRole"
                 data-slot="alert"
                 data-color="@Color.ToAttributeValue()"
                 @attributes="@AdditionalAttributes">
        @if (StartContent is not null)
        {
            <span data-part="start-content">
                @StartContent
            </span>
        }

        <div data-part="content">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div data-part="title">@Title</div>
            }

            @if (ChildContent is not null)
            {
                <div data-part="body">
                    @ChildContent
                </div>
            }
        </div>

        @if (Dismissible)
        {
            <button type="button"
                    data-slot="alert-dismissButton"
                    data-part="dismiss"
                    hidden="@(!ShowDismissButton)"
                    tabindex="@(ShowDismissButton ? 0 : -1)"
                    aria-hidden="@((!ShowDismissButton).ToAttributeValue())"
                    aria-label="Dismiss alert"
                    @onclick="DismissAsync">
                <svg data-part="dismiss-icon"
                     viewBox="0 0 16 16"
                     fill="none"
                     aria-hidden="true"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 4L12 12"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round" />
                    <path d="M12 4L4 12"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round" />
                </svg>
            </button>
        }
    </UiComponent>
}
