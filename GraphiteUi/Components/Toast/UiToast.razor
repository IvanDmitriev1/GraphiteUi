@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiAlert As="article"
         Color="@Color"
         Class="@RootClass"
         Title="@Title"
         Dismissible="true"
         ShowDismissButton="true"
         AutoHideOnDismiss="false"
         OnDismiss="OnDismiss"
         ChildContent="Options.Content"
         data-slot="toast-item"
         data-toast-id="@Id"
         data-duration="@DurationMs"
         data-sticky="@Sticky.ToAttributeValue()"
         aria-live="@AriaLive"
         aria-atomic="true"
         @attributes="@AdditionalAttributes" />
