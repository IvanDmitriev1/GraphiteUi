@namespace GraphiteUi.Components
@inherits UiComponentBase

<div class="@Class"
     @attributes="@AdditionalAttributes"
     data-ui="toast-host"
     data-slot="toast-host"
     data-placement="@Placement.ToAttributeValue()"
     @ref="_rootReference">
    <div data-part="stack"
         data-slot="toast-stack"
         aria-live="polite"
         aria-atomic="false">
        @foreach (var entry in _toastItems)
        {
            <UiToast @key="entry.Id"
                     Id="@entry.Id"
                     Options="@entry.Options"
                     Sticky="@entry.Sticky"
                     OnDismiss="@(() => RemoveToast(entry.Id))">
            </UiToast>
        }
    </div>
</div>
