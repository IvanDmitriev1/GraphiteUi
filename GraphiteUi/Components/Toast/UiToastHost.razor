@namespace GraphiteUi.Components
@inherits UiComponentBase

<div class="@RootClass"
     data-slot="toast-host"
     @attributes="@AdditionalAttributes"
     @ref="_rootReference">
    <div class="@ToastStyles.StackClass"
         data-slot="toast-stack"
         aria-live="polite"
         aria-atomic="false">
        @foreach (var entry in _toastItems)
        {
            <UiToast @key="entry.Id"
                     Id="@entry.Id"
                     Options="@entry.Options"
                     Sticky="@entry.Sticky"
                     OnDismiss="@(() => RemoveToast(entry.Id))">
            </UiToast>
        }
    </div>
</div>
