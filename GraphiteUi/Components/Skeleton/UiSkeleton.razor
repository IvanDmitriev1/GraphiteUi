@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiComponent As="@As"
             Class="@Class"
             DataUi="skeleton"
             data-loading="@IsLoading.ToAttributeValue()"
             aria-busy="@IsLoading.ToAttributeValue()"
             @attributes="@AdditionalAttributes">

    @if (UseCustomSkeleton)
    {
        <div data-part="content">
            @SkeletonContent
        </div>
    }
    else
    {
        <div data-part="content" data-skeleton-mimic="@UseAutoMimic.ToAttributeValue()">
            @ChildContent
        </div>
    }
</UiComponent>
