@namespace GraphiteUi.Components
@inherits UiComponentBase

<div class="@RootClassValue"
     data-slot="popup-root"
     data-disabled="@Disabled.ToAttributeValue()"
     data-close-outside="@CloseOnOutsideClick.ToAttributeValue()"
     data-close-escape="@CloseOnEscape.ToAttributeValue()"
     data-show-backdrop="@ShowBackdrop.ToAttributeValue()"
     data-trigger-mode="@TriggerModeValue"
     @attributes="@AdditionalAttributes"
     @ref="_rootReference">

    <UiComponent As="@TriggerAsValue"
            class="@TriggerClassValue"
            data-slot="popup-trigger"
            data-open="false"
            aria-disabled="@Disabled.ToAttributeValue()"
            aria-expanded="false"
            disabled="@(IsButtonTrigger ? Disabled : null)"
            @attributes="@TriggerAttributes">
        @TriggerContent
    </UiComponent>

    <button type="button"
            data-slot="popup-backdrop"
            data-state="closed"
            class="@PopupStyles.BackdropClass"
            hidden
            tabindex="-1"
            aria-hidden="true"></button>

    <div data-slot="popup-content"
         data-state="closed"
         class="@PopupStyles.ContentClass"
         role="dialog"
         hidden>
        @ChildContent
    </div>
</div>
