@namespace GraphiteUi.Components
@inherits UiComponentBase

<div data-ui="drawer" data-part="host">
    <input id="@ToggleId"
           type="checkbox"
           data-part="toggle"
           disabled="@Disabled" />

    @if (TriggerContent is not null)
    {
        <label for="@ToggleId" data-slot="drawer-trigger" data-part="trigger">
            @TriggerContent
        </label>
    }

    <div class="@Class"
         @attributes="@AdditionalAttributes"
         data-slot="drawer-root"
         data-part="overlay"
       data-side="@Side.ToDrawerSideAttribute()"
         >
        @if (ShowBackdrop)
        {
            <label for="@ToggleId"
                   data-slot="drawer-backdrop"
                   data-part="backdrop"
                   aria-hidden="true"></label>
        }

        <aside data-slot="drawer-panel"
               data-part="panel"
               tabindex="-1"
               role="dialog">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div data-part="header">@Title</div>
            }

            <div data-part="content">
                @ChildContent
            </div>
        </aside>
    </div>
</div>
