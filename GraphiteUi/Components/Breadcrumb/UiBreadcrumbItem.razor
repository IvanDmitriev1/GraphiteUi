@namespace GraphiteUi.Components

<li data-ui="breadcrumb-item" data-part="item" data-current="@Current.ToAttributeValue()">
    @if (!Current && !string.IsNullOrWhiteSpace(Href))
    {
        <a href="@Href"
           data-part="link"
           target="@Target"
           rel="@Rel">
            @ChildContent
        </a>
    }
    else
    {
        <span data-part="current"
              aria-current="@(Current ? "page" : null)">
            @ChildContent
        </span>
    }

    @if (!Current)
    {
        <span data-part="separator"
              aria-hidden="true">/</span>
    }
</li>
