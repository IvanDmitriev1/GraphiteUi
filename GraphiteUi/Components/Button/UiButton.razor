@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiComponent As="@As"
                Class="@RootClass"
                data-slot="button"
                type="@Type.ToHtmlValue()"
                disabled="@NativeDisabled"
                data-disabled="@Disabled.ToAttributeValue()"
                data-loading="@IsLoading.ToAttributeValue()"
                aria-busy="@IsLoading.ToAttributeValue()"
                @attributes="@AdditionalAttributes"
                @onclick="@OnClickAsync">
    <span class="@ContentClass">
        @StartContent
        @ChildContent
        @EndContent
    </span>
    @if (IsLoading)
    {
        <span class="@ButtonStyles.LoadingSpinnerContainerClass" aria-hidden="true">
            <span class="@ButtonStyles.LoadingSpinnerClass"></span>
        </span>
    }
</UiComponent>
