@namespace GraphiteUi.Components
@inherits UiComponentBase

<UiComponent As="@As"
             Class="@Class"
             DataUi="tooltip"
             tabindex="0"
             @attributes="@AdditionalAttributes"
             data-slot="tooltip-root"
             data-tooltip-align="@Align"
             data-align="@Align.ToAttributeValue()"
             data-bottom="@Bottom.ToAttributeValue()">
    @ChildContent

    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <span role="tooltip"
              data-slot="tooltip-bubble"
               data-part="bubble">
            @Text
        </span>
    }
</UiComponent>
