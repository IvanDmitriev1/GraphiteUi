@namespace GraphiteUi.Components
@typeparam TValue
@attribute [CascadingTypeParameter(nameof(TValue))]
@inherits UiInputFieldBase<TValue>

<div data-ui="select"
     data-size="@Size.ToAttributeValue()"
     data-disabled="@Disabled.ToAttributeValue()"
     data-readonly="@ReadOnly.ToAttributeValue()"
     data-invalid="@IsInvalid.ToAttributeValue()">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@InputId" data-part="label" data-slot="label">@Label</label>
    }

    <UiPopup Class="@Class"
         Disabled="@(Disabled || ReadOnly)"
         TriggerMode="open"
         TriggerAs="div"
         TriggerAttributes="@TriggerAttributes"
         data-select-root="true"
         @attributes="@RootAttributes">

        <TriggerContent>
        <input id="@InputId"
               aria-label="@AccessibleLabel"
               aria-describedby="@DescribedBy"
               role="combobox"
               aria-controls="@(InputId + "-options")"
               aria-haspopup="listbox"
               aria-autocomplete="list"
               type="text"
                data-part="input"
               data-slot="select-input"
               value="@SelectedText"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-disabled="@Disabled.ToAttributeValue()"
               aria-invalid="@IsInvalid.ToAttributeValue()"
               aria-expanded="false"
               aria-readonly="@ReadOnly.ToAttributeValue()"
               autocomplete="off" />

        <svg data-part="search-icon"
             viewBox="0 0 20 20"
             fill="none"
             aria-hidden="true"
             xmlns="http://www.w3.org/2000/svg">
            <path d="M14.5 14.5L18 18"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
            <circle cx="9"
                    cy="9"
                    r="6"
                    stroke="currentColor"
                    stroke-width="1.8" />
        </svg>
        </TriggerContent>

        <ChildContent>
        <input type="hidden"
               data-slot="select-value"
               name="@NameAttributeValue"
               value="@HiddenValue" />

        <CascadingValue Value="this" IsFixed="true">
            <div data-part="list"
                 id="@(InputId + "-options")"
                 role="listbox"
                 data-slot="select-list">
                @ChildContent
            </div>
        </CascadingValue>

            <div data-part="empty"
                 data-slot="select-empty"
             hidden>
            @NoSuggestionsText
        </div>

        <div data-part="divider"></div>

        <button type="button"
                data-slot="select-clear"
                data-part="clear"
                disabled="@(!CanClear)"
                aria-disabled="@((!CanClear).ToAttributeValue())"
                @onclick="Clear">
            <svg data-part="clear-icon"
                 viewBox="0 0 20 20"
                 fill="none"
                 aria-hidden="true"
                 xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 5.5V4.5C7.5 3.95 7.95 3.5 8.5 3.5H11.5C12.05 3.5 12.5 3.95 12.5 4.5V5.5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M4.5 5.5H15.5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M6 7.5L6.5 14.5C6.54 15.05 7 15.5 7.55 15.5H12.45C13 15.5 13.46 15.05 13.5 14.5L14 7.5"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M8.5 9V13"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                <path d="M11.5 9V13"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>

            <span>@ClearText</span>
        </button>
        </ChildContent>
    </UiPopup>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p id="@DescriptionId" data-part="description">@Description</p>
    }
</div>
