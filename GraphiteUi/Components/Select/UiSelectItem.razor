@namespace GraphiteUi.Components
@typeparam TValue

<button type="button"
        class="@SelectStyles.ItemClass"
        data-slot="select-item"
        data-value="@ValueString"
        data-text="@DisplayText"
        data-selected="@Parent.IsSelected(Value).ToAttributeValue()"
        data-active="false"
        data-disabled="@IsDisabled.ToAttributeValue()"
        role="option"
        aria-selected="@Parent.IsSelected(Value).ToAttributeValue()"
        disabled="@IsDisabled"
        aria-disabled="@IsDisabled.ToAttributeValue()"
        @onclick="OnClick">
    @if (Template is not null)
    {
        @Template(Value)
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @DisplayText
    }
</button>
