@namespace GraphiteUi.Components
@inherits UiComponentBase

@if (Vertical)
{
    <div class="@Class"
         role="separator"
         aria-orientation="vertical"
         @attributes="@AdditionalAttributes"
         data-ui="divider"
         data-orientation="vertical"
         data-part="root"></div>
}
else
{
    <hr class="@Class"
        @attributes="@AdditionalAttributes"
        data-ui="divider"
        data-orientation="horizontal"
        data-part="root" />
}
