@namespace GraphiteUi.Components
@typeparam TValue

<label data-ui="radio"
       data-part="item"
       data-disabled="@IsDisabled.ToAttributeValue()">

	<input type="radio"
	       data-part="input"
	       data-slot="radio-input"
	       name="@Group!.InputGroupName"
	       value="@FormValue"
	       checked="@Group.IsSelected(Value)"
	       disabled="@IsDisabled"
		   @onchange="() => Group?.Select(Value)" />

	<span data-part="control"
	      data-invalid="@Group!.IsInvalid.ToAttributeValue()">
	</span>

	@if (ChildContent is not null)
	{
		<span data-part="label">@ChildContent</span>
	}
</label>
