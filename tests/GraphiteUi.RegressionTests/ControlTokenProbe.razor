@using GraphiteUi.Components
@using Microsoft.AspNetCore.Components.Forms

<EditForm EditContext="_editContext">
    <UiTextbox @bind-Value="_model.Small" Size="@GraphiteUi.Common.Size.Small" id="control-small" />
    <UiTextbox @bind-Value="_model.Medium" Size="@GraphiteUi.Common.Size.Medium" id="control-medium" />
    <UiTextbox @bind-Value="_model.Large" Size="@GraphiteUi.Common.Size.Large" id="control-large" />
    <UiTextbox @bind-Value="_model.Negative" Size="@((GraphiteUi.Common.Size)(-1))" id="control-negative" />
    <UiTextbox @bind-Value="_model.Invalid" Size="@((GraphiteUi.Common.Size)99)" id="control-invalid" />
    <UiSelect TValue="string" @bind-Value="_model.SelectSmall" Size="GraphiteUi.Common.Size.Small"
              id="select-small" Label="Small select" Description="Small help"
              aria-describedby="caller-help" Class="select-root-probe px-2 px-4" data-select-probe="small">
        <UiSelectItem TValue="string" Value="@("one")" Text="One" />
    </UiSelect>
    <UiSelect TValue="string" @bind-Value="_model.SelectMedium" Size="GraphiteUi.Common.Size.Medium"
              id="select-medium" Label="Medium select" ReadOnly="true" data-select-probe="medium" />
    <UiSelect TValue="string" @bind-Value="_model.SelectLarge" Size="GraphiteUi.Common.Size.Large"
              id="select-large" Label="Large select" Disabled="true" data-select-probe="large" />
    <UiSelect TValue="string" @bind-Value="_model.SelectFallback" Size="@((GraphiteUi.Common.Size)99)"
              id="select-fallback" Label="Fallback select" data-select-probe="fallback" />
    <UiSelect TValue="string" @bind-Value="_model.SelectNoLabel" id="select-no-label"
              aria-label="Caller select label" data-select-probe="no-label" />
</EditForm>

@code {
    private readonly ControlTokenModel _model = new();
    private readonly EditContext _editContext;
    private readonly ValidationMessageStore _messages;

    public ControlTokenProbe()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
        _messages.Add(_editContext.Field(nameof(ControlTokenModel.SelectSmall)), "Required");
    }

    private sealed class ControlTokenModel
    {
        public string Small { get; set; } = string.Empty;
        public string Medium { get; set; } = string.Empty;
        public string Large { get; set; } = string.Empty;
        public string Negative { get; set; } = string.Empty;
        public string Invalid { get; set; } = string.Empty;
        public string SelectSmall { get; set; } = string.Empty;
        public string SelectMedium { get; set; } = string.Empty;
        public string SelectLarge { get; set; } = string.Empty;
        public string SelectFallback { get; set; } = string.Empty;
        public string SelectNoLabel { get; set; } = string.Empty;
    }
}
