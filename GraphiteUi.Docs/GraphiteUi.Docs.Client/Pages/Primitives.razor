@page "/primitives"
@rendermode InteractiveServer

<PageTitle>Primitives</PageTitle>

<h1>Primitives</h1>

<div class="mt-4 max-w-3xl flex flex-col gap-6">
    <section class="flex flex-col gap-2">
        <h2 class="text-medium">Card</h2>
        <UiCard Title="Profile">
            <ChildContent>
                <div class="flex items-center gap-3">
                    <UiAvatar Name="Alex Johnson" />
                    <div class="text-small text-primary-60">alex@example.com</div>
                </div>
            </ChildContent>
            <FooterContent>
                <UiButton Color="ThemeColor.Secondary">View details</UiButton>
            </FooterContent>
        </UiCard>
    </section>

    <section class="flex flex-col gap-2">
        <h2 class="text-medium">Divider</h2>
        <div class="flex items-center gap-3">
            <span>Left</span>
            <UiDivider Vertical="true" class="h-6" />
            <span>Right</span>
        </div>
        <UiDivider />
    </section>

    <section class="flex flex-col gap-2">
        <h2 class="text-medium">Avatar + Tooltip</h2>
        <div class="flex items-center gap-3">
            <UiTooltip Text="Alex Johnson">
                <UiAvatar Name="Alex Johnson" />
            </UiTooltip>
            <UiTooltip Text="Nina Park">
                <UiAvatar Name="Nina Park" Size="Size.Large" />
            </UiTooltip>
        </div>
    </section>
</div>
