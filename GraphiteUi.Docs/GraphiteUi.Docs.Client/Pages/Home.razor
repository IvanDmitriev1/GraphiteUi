@page "/"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IToastService ToastService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<div class="flex flex-row flex-wrap gap-2">
    <UiButton OnClick="Callback">Primary</UiButton>
    <UiButton Color="ThemeColor.Info" Variant="ButtonVariant.Outline" OnClick="ShowInfoToast">Toast</UiButton>
    <UiButton Variant="ButtonVariant.Outline" Disabled="true">Disabled</UiButton>
    <UiButton Color="ThemeColor.Danger" Variant="ButtonVariant.Outline">Danger</UiButton>
    <UiButton Color="ThemeColor.Success" Variant="ButtonVariant.Ghost">Success</UiButton>
    <UiButton Color="ThemeColor.Warning" Variant="ButtonVariant.Ghost">Warning</UiButton>
    <UiButton As="a" href="/simple-form" Variant="ButtonVariant.Ghost">Link</UiButton>
    <UiButton As="a" href="/skeleton" Variant="ButtonVariant.Link">Skeleton</UiButton>
    <UiButton As="a" href="/notifications" Variant="ButtonVariant.Link">Notifications</UiButton>
    <UiButton As="a" href="/data-display" Variant="ButtonVariant.Link">Data Display</UiButton>
    <UiButton As="a" href="/navigation" Variant="ButtonVariant.Link">Navigation</UiButton>
    <UiButton As="a" href="/form-controls" Variant="ButtonVariant.Link">Form Controls</UiButton>
    <UiButton As="a" href="/primitives" Variant="ButtonVariant.Link">Primitives</UiButton>
    <UiButton As="a" href="/theme-lab" data-enhance-nav="false" Variant="ButtonVariant.Link">Color lab</UiButton>
</div>

@code {
    private async Task Callback()
    {
        _ = await DialogService.ShowAsync<TestDialog, bool>(new DialogOptions()
        {
			DismissOnOverlayClick = true,
            CloseOnEscape = true,
            Classes = "md:max-w-md"
        }, null);
    }

    private void ShowInfoToast()
    {
        ToastService.Show(new ToastOptions
        {
            Color = ThemeColor.Info,
            Title = "Welcome",
            Content = builder => builder.AddContent(0, "Toast notifications are now available.")
        });
    }
}
