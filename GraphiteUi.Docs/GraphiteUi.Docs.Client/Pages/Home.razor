@page "/"
@rendermode InteractiveServer
@inject IDialogService DialogService
@inject IToastService ToastService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<div class="flex flex-row flex-wrap gap-1">
    <UiButton OnClick="Callback">Primary</UiButton>
    <UiButton Color="ThemeColor.Info" OnClick="ShowInfoToast">Toast</UiButton>
    <UiButton Disabled="true">Disabled</UiButton>
    <UiButton Color="ThemeColor.Danger">Danger</UiButton>
    <UiButton Color="ThemeColor.Success">Success</UiButton>
    <UiButton Color="ThemeColor.Warning">Warning</UiButton>
    <UiButton As="a" href="/simple-form">Link</UiButton>
    <UiButton As="a" href="/skeleton">Skeleton</UiButton>
    <UiButton As="a" href="/notifications">Notifications</UiButton>
    <UiButton As="a" href="/data-display">Data Display</UiButton>
    <UiButton As="a" href="/navigation">Navigation</UiButton>
    <UiButton As="a" href="/form-controls">Form Controls</UiButton>
    <UiButton As="a" href="/primitives">Primitives</UiButton>
</div>

@code {
    private async Task Callback()
    {
        _ = await DialogService.ShowAsync<TestDialog, bool>(new DialogOptions()
        {
			DismissOnOverlayClick = true,
            CloseOnEscape = true,
            Classes = "md:max-w-md"
        }, null);
    }

    private void ShowInfoToast()
    {
        ToastService.Show(new ToastOptions
        {
            Color = ThemeColor.Info,
            Title = "Welcome",
            Content = builder => builder.AddContent(0, "Toast notifications are now available.")
        });
    }
}
