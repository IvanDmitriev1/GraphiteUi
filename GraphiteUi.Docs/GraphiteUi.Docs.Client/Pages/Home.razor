@page "/"
@rendermode InteractiveServer
@inject IDialogService DialogService

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<div class="flex" flex-row gap-1>
    <UiButton OnClick="Callback">Primary</UiButton>
    <UiButton Disabled="true">Disabled</UiButton>
    <UiButton Color="ThemeColor.Danger">Danger</UiButton>
    <UiButton Color="ThemeColor.Success">Success</UiButton>
    <UiButton Color="ThemeColor.Warning">Warning</UiButton>
    <UiButton As="a" href="/simple-form">Link</UiButton>
</div>

@code {
    private async Task Callback()
    {
        var result = await DialogService.ShowAsync<TestDialog, bool>(new DialogOptions()
        {
			DismissOnOverlayClick = true,
            CloseOnEscape = true,
            Classes = "max-w-md"
        }, null);
    }
}
