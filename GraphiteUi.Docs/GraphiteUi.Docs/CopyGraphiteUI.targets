<Project>
	<PropertyGroup>
		<SolutionDir Condition="'$(SolutionDir)' == '' ">$(MSBuildThisFileDirectory)../../</SolutionDir>
	</PropertyGroup>

	<Target Name="GraphiteUiDocs_CopyLocalThemeContents" BeforeTargets="Build">
		<ItemGroup>
			<GraphiteUiDocsCssSources Include="$(SolutionDir)/GraphiteUi/Styles/*.css" />
		</ItemGroup>

		<MakeDir Directories="$(MSBuildProjectDirectory)/bin/GraphiteUi/Styles" />
		<Copy SourceFiles="@(GraphiteUiDocsCssSources)"
		      DestinationFiles="@(GraphiteUiDocsCssSources->'$(MSBuildProjectDirectory)/bin/GraphiteUi/Styles/%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
