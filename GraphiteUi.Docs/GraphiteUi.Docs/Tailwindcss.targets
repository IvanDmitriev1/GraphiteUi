<Project>
  <PropertyGroup>
    <GraphiteUiRepositoryRoot>$(MSBuildThisFileDirectory)../../</GraphiteUiRepositoryRoot>
    <TailwindCliScript Condition="'$(TailwindCliScript)' == ''">$(GraphiteUiRepositoryRoot)node_modules/@tailwindcss/cli/dist/index.mjs</TailwindCliScript>
    <TailwindInput>wwwroot/styles/app.css</TailwindInput>
    <TailwindOutput>wwwroot/app.css</TailwindOutput>
  </PropertyGroup>
  <ItemGroup>
    <TailwindInputs Include="$(MSBuildProjectDirectory)/wwwroot/styles/*.css" />
    <TailwindInputs Include="$(GraphiteUiRepositoryRoot)GraphiteUi/Styles/*" />
    <TailwindInputs Include="$(MSBuildProjectDirectory)/../GraphiteUi.Docs.Client/**/*.razor" />
  </ItemGroup>
  <Target Name="RunTailwind" BeforeTargets="PrepareForBuild"
          DependsOnTargets="GraphiteUiDocs_CopyLocalThemeContents"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(TailwindInputs);$(TailwindCliScript);$(MSBuildThisFileFullPath)"
          Outputs="$(MSBuildProjectDirectory)/$(TailwindOutput)">
    <Error Condition="!Exists('$(TailwindCliScript)')" Text="Run npm ci in the GraphiteUi repository before building the docs app." />
    <Exec Command="node &quot;$(TailwindCliScript)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" />
  </Target>
</Project>
